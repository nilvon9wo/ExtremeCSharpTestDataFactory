<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Net.Nowhereatall.Xfty.VectorDatabases.MicrosoftExtensionsVectorData</RootNamespace>
    <AssemblyName>Net.Nowhereatall.Xfty.VectorDatabases.MicrosoftExtensionsVectorData</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Xfty.VectorDatabases.MicrosoftExtensionsVectorData</PackageId>
    <Version>0.1.0-preview.2</Version>
    <Authors>Brian Kessler</Authors>
    <Description>PREVIEW / proof-of-concept: an IPersistenceGateway that inserts XFTY-generated records into any Microsoft.Extensions.VectorData-backed vector store (Qdrant, Redis, Azure AI Search, pgvector, and more) - no provider-specific dependency in this package at all. See this package's README for known assumptions, risks, and why it is not versioned as a beta.</Description>
    <PackageTags>testing;test-data;test-data-builder;fixtures;xunit;vector-database;preview</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/nilvon9wo/ExtremeCSharpTestDataFactory</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nilvon9wo/ExtremeCSharpTestDataFactory</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.VectorData.Abstractions" Version="10.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xfty\Xfty.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
