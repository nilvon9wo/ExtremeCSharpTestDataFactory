<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Net.NowhereAtAll.Xfty.EntityFrameworkCore</RootNamespace>
    <AssemblyName>Net.NowhereAtAll.Xfty.EntityFrameworkCore</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Xfty.EntityFrameworkCore</PackageId>
    <Version>1.0.0-beta.4</Version>
    <Authors>Brian Kessler</Authors>
    <Description>An IPersistenceGateway implementation for XFTY that inserts generated records through Entity Framework Core, instead of mocking them.</Description>
    <PackageTags>testing;test-data;test-data-builder;fixtures;xunit;entity-framework-core;ef-core</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/nilvon9wo/ExtremeCSharpTestDataFactory</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nilvon9wo/ExtremeCSharpTestDataFactory</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xfty\Xfty.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
