<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Net.NowhereAtAll.Xfty.VectorDatabases.MicrosoftExtensionsVectorData.Test</RootNamespace>
    <AssemblyName>Net.NowhereAtAll.Xfty.VectorDatabases.MicrosoftExtensionsVectorData.Test</AssemblyName>
  </PropertyGroup>

  <!--
    Qdrant appears only here, as ONE concrete VectorStore to prove the
    gateway against - the shipped package above has no Qdrant dependency
    at all. See the package README for why that separation matters.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.Qdrant" Version="1.74.0-preview" />
    <PackageReference Include="Qdrant.Client" Version="1.19.0" />
    <PackageReference Include="Testcontainers.Qdrant" Version="4.14.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xfty\Xfty.csproj" />
    <ProjectReference Include="..\Xfty.VectorDatabases\Xfty.VectorDatabases.csproj" />
    <ProjectReference Include="..\Xfty.VectorDatabases.MicrosoftExtensionsVectorData\Xfty.VectorDatabases.MicrosoftExtensionsVectorData.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
