<Project>

  <!--
    Without EnforceCodeStyleInBuild, the strict IDE0xxx/error-severity rules
    in .editorconfig are enforced only by an IDE's live analysis (or
    `dotnet format`), never by `dotnet build` or CI - a silent gap that let
    real violations through undetected. This closes it for every project in
    the solution.
  -->
  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!--
    Without this, each multi-targeted TFM's compile pass infers its own
    default C# language version - netstandard2.0 defaults to a much older
    one unless told otherwise, and would reject init accessors, primary
    constructors, collection expressions, etc. outright. Pinning this once,
    solution-wide, keeps every TFM's compile pass on the same modern syntax
    rules; per-TFM *runtime*-capability gaps (not syntax) are still handled
    separately, per project, via PolySharp/#if.
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!--
    Single source of truth for the version of every mainline (non-preview)
    publishable package - `Xfty`, `Xfty.EntityFrameworkCore`,
    `Xfty.EntityFramework6`, `Xfty.Bogus`, `Xfty.VectorDatabases`, `Xfty.Xunit`,
    `Xfty.AutoFixture`, `Xfty.AutoBogus`, `Xfty.FSharpAsync`. They no longer
    carry their own <Version>; they inherit this one, so they stay in
    lockstep automatically.

    `0.0.0-dev` is only the LOCAL-build fallback (a `dotnet pack` on a dev
    machine produces `*.0.0.0-dev.nupkg`, obviously not a release). The real
    release version is NOT set here and is NOT bumped per release: the
    `publish.yml` workflow reads the newest `## [x.y.z]` heading from
    CHANGELOG.md and stamps it in (`-p:Version=` / an in-runner edit of this
    file) at pack time. Cutting a release = adding that CHANGELOG heading in
    your PR; merging to master publishes it. See docs/contribute/packaging.md.

    The two PREVIEW packages (`Xfty.VectorDatabases.Qdrant`,
    `Xfty.VectorDatabases.MicrosoftExtensionsVectorData`) deliberately keep
    their own <Version> (`0.x-preview.*`) in their own .csproj - that value
    overrides this one because the project sets it after this import.
  -->
  <PropertyGroup>
    <Version>0.0.0-dev</Version>
  </PropertyGroup>

  <!--
    Coverage is not an optional extra: every `dotnet test` of a `*.Test`
    project, local or CI, measures the one package that project tests and
    fails below 100% line AND branch coverage. XFTY must never be the cause of
    a consumer's test failure, so every guard and both sides of every branch
    are exercised (docs/contribute/coverage-standards.md).

    - coverlet.MTP, not coverlet.collector: global.json selects the Microsoft
      Testing Platform runner, and coverlet.collector is a VSTest data
      collector - under MTP its documented "XPlat Code Coverage" collect option runs
      zero tests and exits 5 (invalid arguments), so coverage was silently
      never measured.
    - The include filter is derived from the project name (`Xfty.Bogus.Test`
      measures `Net.NowhereAtAll.Xfty.Bogus`). Without one, every loaded
      assembly is instrumented - xunit's own included - and the minimum drags
      the threshold check to 0%.
    - Xfty.NetStandardCompat.Test is a net472 smoke test across several
      packages, not a unit suite for one; it is not measured.
    - Running a filtered subset (one class, or the Performance category)
      cannot reach 100%: pass `-p:XftyCoverage=false` to `dotnet test` for
      those runs.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Test')) And '$(MSBuildProjectName)' != 'Xfty.NetStandardCompat.Test'">
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <XftyCoverage Condition="'$(XftyCoverage)' == ''">true</XftyCoverage>
    <XftyCoveredAssembly>Net.NowhereAtAll.$(MSBuildProjectName.Substring(0, $(MSBuildProjectName.LastIndexOf('.Test'))))</XftyCoveredAssembly>
  </PropertyGroup>
  <PropertyGroup Condition="'$(XftyCoverage)' == 'true'">
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --coverlet --coverlet-include "[$(XftyCoveredAssembly)]*" --coverlet-output-format cobertura --coverlet-threshold 100 --coverlet-threshold-type line --coverlet-threshold-type branch</TestingPlatformCommandLineArguments>
  </PropertyGroup>
  <ItemGroup Condition="'$(XftyCoveredAssembly)' != ''">
    <PackageReference Include="coverlet.MTP" Version="10.1.0" />
  </ItemGroup>

</Project>
