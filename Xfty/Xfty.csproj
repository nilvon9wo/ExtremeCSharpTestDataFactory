<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Net.Nowhereatall.Xfty</RootNamespace>
    <AssemblyName>Net.Nowhereatall.Xfty</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Makes SharedRandom (and, on netstandard2.0 only, the GetValueOrDefault/
      ToHashSet polyfills) visible project-wide without a per-file `using` -
      harmless on net8.0/net10.0, where the polyfill extension methods don't
      exist at all (guarded out by #if), so there's nothing to collide with.
    -->
    <Using Include="Net.Nowhereatall.Xfty.Internal" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Supplies IsExternalInit (the marker type `init` accessors need) on
      netstandard2.0, where it isn't part of the real BCL - a no-op on
      net8.0/net10.0, where the real type already exists. PrivateAssets="all"
      so it never becomes a dependency consumers see.
    -->
    <PackageReference Include="PolySharp" Version="1.16.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <PackageId>Xfty</PackageId>
    <Version>1.0.0-beta.4</Version>
    <Authors>Brian Kessler</Authors>
    <Description>A declarative test data factory: describe only the fields your test cares about, and XFTY generates the rest of the object graph - required/optional relationships, shared ancestors, context-aware values - then mocks or actually persists it through a pluggable IPersistenceGateway.</Description>
    <PackageTags>testing;test-data;test-data-builder;fixtures;xunit;object-mother;test-data-factory</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/nilvon9wo/ExtremeCSharpTestDataFactory</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nilvon9wo/ExtremeCSharpTestDataFactory</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
