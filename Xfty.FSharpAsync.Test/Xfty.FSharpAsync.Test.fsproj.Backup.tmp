<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>Net.NowhereAtAll.Xfty.FSharpAsync.Test</RootNamespace>
    <AssemblyName>Net.NowhereAtAll.Xfty.FSharpAsync.Test</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="RecordProviderAsyncTest.fs" />
    <Compile Include="TypedRecordProviderAsyncTest.fs" />
    <Compile Include="DeferredInserterAsyncTest.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xfty\Xfty.csproj" />
    <ProjectReference Include="..\Xfty.FSharpAsync\Xfty.FSharpAsync.fsproj" />
  </ItemGroup>

</Project>
