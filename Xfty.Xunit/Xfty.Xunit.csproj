<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Net.Nowhereatall.Xfty.Xunit</RootNamespace>
    <AssemblyName>Net.Nowhereatall.Xfty.Xunit</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Xfty.Xunit</PackageId>
    <Version>1.0.0-beta.2</Version>
    <Authors>Brian Kessler</Authors>
    <Description>xUnit integration for XFTY: [IsolatesSharedAncestor], an attribute for a test class or method that resets SharedAncestor's registry before and after - so a consumer never has to hand-wire a base test class or fixture to keep shared-ancestor state from leaking between tests.</Description>
    <PackageTags>testing;test-data;test-data-builder;fixtures;xunit</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/nilvon9wo/ExtremeCSharpTestDataFactory</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nilvon9wo/ExtremeCSharpTestDataFactory</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!-- Not a test project - references the extensibility slice only, per xunit.v3's own build-time guidance. -->
    <PackageReference Include="xunit.v3.extensibility.core" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xfty\Xfty.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
