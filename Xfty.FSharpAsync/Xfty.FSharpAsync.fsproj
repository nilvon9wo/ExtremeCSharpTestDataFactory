<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Net.NowhereAtAll.Xfty.FSharpAsync</RootNamespace>
    <AssemblyName>Net.NowhereAtAll.Xfty.FSharpAsync</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Xfty.FSharpAsync</PackageId>
    <Version>1.0.0-beta.5</Version>
    <Authors>Brian Kessler</Authors>
    <Description>F#-idiomatic Async&lt;'T&gt; wrappers over XFTY's Task-based API, for F# codebases built on the original async { } workflow rather than the newer task { } computation expression (which already consumes XFTY's Task-returning API directly - see this package's README for when you do and don't need this at all).</Description>
    <PackageTags>testing;test-data;test-data-builder;fixtures;xunit;fsharp;async</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/nilvon9wo/ExtremeCSharpTestDataFactory</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nilvon9wo/ExtremeCSharpTestDataFactory</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="RecordProviderAsync.fs" />
    <Compile Include="TypedRecordProviderAsync.fs" />
    <Compile Include="DeferredInserterAsync.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xfty\Xfty.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
