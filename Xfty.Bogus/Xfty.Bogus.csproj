<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Net.Nowhereatall.Xfty.Bogus</RootNamespace>
    <AssemblyName>Net.Nowhereatall.Xfty.Bogus</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Xfty.Bogus</PackageId>
    <Version>1.0.0-beta.4</Version>
    <Authors>Brian Kessler</Authors>
    <Description>Bundled IValueExpressions for XFTY that produce realistic-looking fake data - names, emails, addresses, paragraphs - by wrapping Bogus, instead of every Provider writing its own.</Description>
    <PackageTags>testing;test-data;test-data-builder;fixtures;xunit;bogus;fake-data</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/nilvon9wo/ExtremeCSharpTestDataFactory</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nilvon9wo/ExtremeCSharpTestDataFactory</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bogus" Version="35.6.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xfty\Xfty.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
