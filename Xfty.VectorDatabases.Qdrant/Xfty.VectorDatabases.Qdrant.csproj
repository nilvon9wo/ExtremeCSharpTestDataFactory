<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Net.Nowhereatall.Xfty.VectorDatabases.Qdrant</RootNamespace>
    <AssemblyName>Net.Nowhereatall.Xfty.VectorDatabases.Qdrant</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Xfty.VectorDatabases.Qdrant</PackageId>
    <Version>0.1.0-preview.2</Version>
    <Authors>Brian Kessler</Authors>
    <Description>PREVIEW / proof-of-concept: an IPersistenceGateway that inserts XFTY-generated records into a real Qdrant vector database through Qdrant's own client directly - no Microsoft.Extensions.VectorData. See this package's README for known assumptions, risks, and why it is not versioned as a beta.</Description>
    <PackageTags>testing;test-data;test-data-builder;fixtures;xunit;vector-database;qdrant;preview</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/nilvon9wo/ExtremeCSharpTestDataFactory</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nilvon9wo/ExtremeCSharpTestDataFactory</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Qdrant.Client" Version="1.19.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xfty\Xfty.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
